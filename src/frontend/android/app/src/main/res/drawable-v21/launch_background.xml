<?xml version="1.0" encoding="utf-8"?>
<!-- 原生启动屏（API 21 ~ 30）：品牌渐变 + 居中 App 图标。
     底色与 Flutter 启动动画首帧一致，避免黑屏/白屏闪一下。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/splash_bg_mid"
                android:endColor="@color/splash_bg_end"
                android:startColor="@color/splash_bg_deep"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
