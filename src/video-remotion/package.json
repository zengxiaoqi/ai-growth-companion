{
  "name": "lingxi-video-remotion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render NumbersVideo out/numbers-1-10.mp4",
    "build": "remotion render NumbersVideo out/numbers-1-10.mp4 --codec=h264",
    "render:characters": "remotion render ChineseCharactersVideo out/chinese-characters.mp4 --codec=h264",
    "typecheck:3d": "tsc -p tsconfig.check3d.json --noEmit",
    "render:3d-check": "node scripts/render-3d-lesson.cjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "^4.0.261",
    "@remotion/google-fonts": "^4.0.261",
    "@remotion/lottie": "^4.0.446",
    "@remotion/media": "^4.0.261",
    "@remotion/three": "^4.0.261",
    "@remotion/transitions": "^4.0.261",
    "lottie-web": "^5.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.261",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
