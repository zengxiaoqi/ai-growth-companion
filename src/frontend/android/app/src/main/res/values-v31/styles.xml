<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+（SplashScreen API）原生启动屏：品牌底色 + 居中图标，
         紧接着由 Flutter 启动动画接管，两者首帧同色，视觉上是一段连续动画。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_bg_deep</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/splash_bg_deep</item>
        <item name="android:navigationBarColor">@color/splash_bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
