# 服务器配置
PORT=3001
NODE_ENV=development

# 数据库配置 (SQLite)
DB_PATH=lingxi.db

# JWT 配置
JWT_SECRET=lingxi-secret-key-change-in-production

# Redis 配置 (可选)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# AI / LLM 配置 (pi-ai 多 Provider 支持)
# 主 Provider
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# 备用 Provider (自动 fallback，可选)
# LLM_FALLBACK_PROVIDER=deepseek
# LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
# LLM_FALLBACK_API_KEY=your-deepseek-key
# LLM_FALLBACK_MODEL=deepseek-chat
# LLM_FALLBACK_MAX_TOKENS=4096
# LLM_FALLBACK_TEMPERATURE=0.7

# 阿里云短信/语音配置 (紧急呼叫功能)
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SMS_SIGN_NAME=灵犀伴学
ALIBABA_CLOUD_SMS_TEMPLATE_CODE=
ALIBABA_CLOUD_VOICE_TTS_CODE=

# Teaching video third-party generation (async queue)
# VIDEO_PROVIDER_MODE: hybrid | local_only | off
VIDEO_PROVIDER_MODE=hybrid
VIDEO_PROVIDER_NAME=vibemotion
VIDEO_PROVIDER_BASE_URL=
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_CREATE_PATH=/v1/video/tasks
VIDEO_PROVIDER_STATUS_PATH=/v1/video/tasks/{taskId}
VIDEO_PROVIDER_REQUEST_TIMEOUT_MS=20000
VIDEO_PROVIDER_EXTRA_HEADERS_JSON=
VIDEO_PROVIDER_CREATE_BODY_MODE=generic
VIDEO_PROVIDER_CREATE_INPUT_KEY=input
VIDEO_PROVIDER_CREATE_VIDEO_URL_PATHS=videoUrl,url,data.videoUrl,result.videoUrl
VIDEO_PROVIDER_CREATE_TASK_ID_PATHS=taskId,jobId,id,data.taskId,data.id
VIDEO_PROVIDER_STATUS_STATE_PATHS=status,state,data.status,result.status
VIDEO_PROVIDER_STATUS_PROGRESS_PATHS=progress,percent,data.progress,result.progress
VIDEO_PROVIDER_STATUS_ERROR_PATHS=error,message,data.error,result.error
VIDEO_PROVIDER_STATUS_VIDEO_URL_PATHS=videoUrl,url,downloadUrl,data.videoUrl,data.url,result.videoUrl,result.url
VIDEO_PROVIDER_DOWNLOAD_TIMEOUT_MS=45000
VIDEO_PROVIDER_DOWNLOAD_MAX_MB=80
VIDEO_PROVIDER_DOWNLOAD_HOST_ALLOWLIST=
VIDEO_PROVIDER_ALLOW_HTTP_DOWNLOAD=false
VIDEO_PROVIDER_ALLOW_PRIVATE_DOWNLOAD_HOSTS=false

# Queue/cache settings
VIDEO_TASK_POLL_INTERVAL_MS=3000

# External skills directory
SKILLS_DIR=../../skills

VIDEO_PROVIDER_POLL_MS=2500
VIDEO_PROVIDER_POLL_MAX_TIMES=120
VIDEO_TASK_MAX_RETRIES=2
VIDEO_CACHE_TTL_HOURS=72

# DSH enhanced rendering backend (renderEngine: dsh)
VIDEO_DSH_ENABLED=true
VIDEO_DSH_TIMEOUT_MS=900000
VIDEO_DSH_MAX_CONCURRENCY=2
DSH_BIN=dsh
DSH_PROFILE=headless

# ─────────────────────────────────────────────────────────────
# Schema sync (see docs/FEATURE-PORT-from-suinian.md §5)
# ─────────────────────────────────────────────────────────────
# false → the schema is owned by migrations; true/unset → current
# behaviour (auto-sync). The baseline migration covers every table and
# reconciles the columns that post-date older databases, so false is safe
# on both an empty database and one that was built by `synchronize` before
# migrations existed. Either order works; false from the start is the one
# that never lets a stray ALTER through.
DB_SYNCHRONIZE=true

# ─────────────────────────────────────────────────────────────
# Child safety circuit breaker
# ─────────────────────────────────────────────────────────────
# The synchronous word list. Production must leave this on; the switch
# exists for local development only.
SAFETY_ENABLED=true
# Optional YAML with extra terms; missing/unparseable falls back to the
# built-in list (fail-closed).
SAFETY_RULES_FILE=
# Second-layer classifier bands. Asymmetric on purpose: a watch score only
# queues for the parent, a false high would interrupt the child.
SAFETY_CLASSIFIER_ENABLED=true
SAFETY_HIGH_THRESHOLD=0.6
SAFETY_WATCH_THRESHOLD=0.35

# ─────────────────────────────────────────────────────────────
# Long-term memory (agent tools: recallMemory / saveMemory)
# ─────────────────────────────────────────────────────────────
# Verbatim gate: below this confidence a candidate is discarded.
MEMORY_CONFIDENCE_THRESHOLD=0.75
# Fuzzy tier of the verbatim gate. 0.95 is the shipped value; lowering it
# makes "the model paraphrased" indistinguishable from "the child said it".
MEMORY_FUZZY_RATIO=0.95
MEMORY_TOP_K=8
MEMORY_VEC_THRESHOLD=0.4
MEMORY_RRF_K0=60
MEMORY_RRF_W_VEC=1.0
MEMORY_RRF_W_FTS=0.8
MEMORY_RRF_W_TIME=0.6
MEMORY_HALF_LIFE_DAYS=14
MEMORY_DB_TIMEOUT_MS=200
MEMORY_VECTOR_TIMEOUT_MS=400
# Optional OpenAI-compatible embedding model. Unset → the semantic channel
# is absent and recall runs on the literal + temporal channels only.
MEMORY_EMBED_MODEL=

# ─────────────────────────────────────────────────────────────
# Proactive care (ask about it later)
# ─────────────────────────────────────────────────────────────
CARE_ENABLED=true
# When a care question may *open* a conversation (local time).
CARE_WINDOW_START=15:30
CARE_WINDOW_END=20:00
# A cue older than this is expired rather than asked.
CARE_EXPIRE_DAYS=3
CARE_MAX_POSTPONE=3
# Global per-child gate: at most one care question per this many hours.
CARE_MIN_GAP_HOURS=24
